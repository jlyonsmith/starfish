// Admin messages

#![format = 1]

// Add user
struct UserAdd {
    alias: string,
    email: string,
    firstName: string,
    lastName: string,
}

// Update user
struct UserUpdate {
    alias: string,
    email: string?,
    firstName: string?,
    lastName: string?,
}

struct UserAddResponse {
    id: i64,
}

// Delete user
struct UserRemove {
    alias: string,
}
