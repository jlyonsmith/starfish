# Install as /etc/systemd/system/starfish-agent.service.
#
# Create the service account first.  It owns nothing and logs in nowhere; its
# only privilege is the single sudo rule in starfish-sync.sudoers.
#
#   adduser --system --group --no-create-home --shell /usr/sbin/nologin starfish
#
[Unit]
Description=Starfish user synchronization agent
After=network-online.target
Wants=network-online.target

# The agent reconnects on its own, so a controller it cannot reach is not a
# reason to give up and stay down.  This belongs in [Unit]; systemd ignores it
# with a warning if it is put under [Service].
StartLimitIntervalSec=0

[Service]
Type=exec
User=starfish
Group=starfish
ExecStart=/usr/local/bin/starfish-agent --config /etc/starfish_agent.conf
Restart=always
RestartSec=5

# The starfish-sync helper is started by sudo as a child of this unit.
# If you are having problems running the do `cat /proc/<pid>/status and
# check the `NoNewPrivs` flag is not set.

# These options are disabled to allow sudo privilege escalation
NoNewPrivileges=no
RestrictNamespaces=no
RestrictRealtime=no
RestrictSUIDSGID=no
LockPersonality=no
MemoryDenyWriteExecute=no
ProtectKernelTunables=no
ProtectKernelModules=no

# These options are safe to keep and will not force NoNewPrivileges
ProtectSystem=yes
ProtectHome=no
PrivateTmp=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
